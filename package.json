{
  "name": "pomar-central-operacional",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run test && npm run build && npm run typecheck",
    "preflight": "node scripts/preflight.mjs",
    "preflight:release": "node scripts/preflight.mjs --release",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "format:check": "prettier --check src tests scripts docs README.md AGENTS.md next.config.ts",
    "format": "prettier --write src tests scripts docs README.md AGENTS.md next.config.ts",
    "test:production": "node scripts/test-production.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.63.0",
    "next": "16.4.3",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "typescript": "7.0.2"
  }
}
