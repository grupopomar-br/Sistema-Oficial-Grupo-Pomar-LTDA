# Variáveis do PROJETO SUPABASE correto. Nunca incluir valores reais no Git.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
POMAR_ENVIRONMENT=development
# UUID do único proprietário criado em Authentication > Users; não é ID de organização.
POMAR_OWNER_USER_ID=

# Integração de cobrança OPCIONAL. Permanece desativada até a homologação.
POMAR_BILLING_ENABLED=false
POMAR_PAYMENT_MODE=test
POMAR_MP_ACCESS_TOKEN=
POMAR_MP_WEBHOOK_SECRET=
POMAR_MP_COLLECTOR_ID=
# URI do pooler do MESMO projeto; usuário pomar_billing_worker.PROJECT_REF, nunca postgres.
POMAR_BILLING_DATABASE_URL=
# Certificado CA do projeto, em base64, se necessário para a validação TLS.
POMAR_BILLING_DB_CA_BASE64=
# Só preencher após homologação em projeto de produção separado.
POMAR_BILLING_LIVE_CONFIRMED=
